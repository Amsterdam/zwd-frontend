{
  "name": "zwd-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite",
    "ont": "vite --mode ontwikkel",
    "acc": "vite --mode acceptatie",
    "build": "tsc -b && vite build",
    "format:check": "prettier --check src",
    "format": "prettier --write src",
    "generate:api-schema:local": "npx --yes openapi-typescript http://localhost:8081/api/schema/ -o ./src/__generated__/apiSchema.d.ts",
    "generate:api-schema:acc": "npx --yes openapi-typescript https://acc.api.zwd.amsterdam.nl/api/schema/ -o ./src/__generated__/apiSchema.d.ts",
    "lint": "eslint --max-warnings 0 --cache src",
    "lint:fix": "eslint --cache --fix src",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@amsterdam/design-system-react": "^4.1.0",
    "@amsterdam/design-system-react-icons": "^2.0.0",
    "axios": "^1.15.0",
    "bpmn-js": "^18.14.0",
    "dayjs": "^1.11.13",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "immer": "^11.1.4",
    "jspdf": "^4.2.1",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "lodash.debounce": "^4.0.8",
    "proj4": "^2.20.2",
    "qs": "^6.15.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.88.0",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.20",
    "@types/lodash.debounce": "^4.0.9",
    "@types/qs": "^6.15.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.5",
    "vitest": "^4.1.0"
  }
}
